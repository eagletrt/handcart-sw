# Handcart frontend: serves the touch UI, talks to the backend only through its API.
#
# Goes to: /etc/systemd/system/handcart-frontend.service
# Installed by: ./handcart.py install-services, which fills in {{USER}}, {{ROOT}} and {{UV_DIR}}

[Unit]
# never give up restarting: by default systemd stops after 5 failures in 10 s, and the service stays down
StartLimitIntervalSec=0
Description=Handcart frontend
After=handcart-backend.service

[Service]
User={{USER}}
WorkingDirectory={{ROOT}}
Environment=PATH={{UV_DIR}}:/usr/local/bin:/usr/bin:/bin
ExecStart={{ROOT}}/handcart.py frontend
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
