# Handcart display: shows the frontend full screen on the touch display, with no desktop around it.
# Runs Chromium in kiosk mode inside cage, a minimal Wayland compositor, on the first console.
# The boot splash stays on screen until the frontend answers, so the eagle goes straight to the UI.
#
# Needs: sudo apt install cage chromium-browser plymouth curl
# Goes to: /etc/systemd/system/handcart-display.service
# Installed by: ./handcart.py install-services, which fills in {{USER}} and {{FRONTEND_PORT}}
# Not yet tried on the handcart Pi.

[Unit]
# never give up restarting: by default systemd stops after 5 failures in 10 s, and the service stays down
StartLimitIntervalSec=0
Description=Handcart display
Wants=handcart-frontend.service
After=handcart-frontend.service systemd-user-sessions.service plymouth-start.service
Conflicts=getty@tty1.service

[Service]
User={{USER}}
PAMName=login
TTYPath=/dev/tty1
StandardInput=tty
# cage draws a pointer in the middle of the screen that the touch never moves: cursors come only from a
# transparent "default" theme (installed by ./handcart.py install-services), the one cage loads
Environment=XCURSOR_PATH=/usr/share/handcart-cursors XCURSOR_THEME=default XCURSOR_SIZE=24
# wait up to 60 s for the frontend, then hand the screen over without clearing the splash
ExecStartPre=-/usr/bin/timeout 60 /bin/sh -c 'until curl -sf http://localhost:{{FRONTEND_PORT}}/ >/dev/null; do sleep 0.5; done'
ExecStartPre=+-/usr/bin/plymouth quit --retain-splash
# --password-store=basic: no "Choose password for new keyring" window at every start
ExecStart=/usr/bin/cage -- /usr/bin/chromium-browser --password-store=basic --kiosk --noerrdialogs --disable-infobars --incognito --no-first-run --disable-session-crashed-bubble --disable-pinch --overscroll-history-navigation=0 --check-for-update-interval=31536000 http://localhost:{{FRONTEND_PORT}}/?kiosk=true
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
